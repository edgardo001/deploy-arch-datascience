# ─────────────────────────────────────────────────────────────────────
# DataLab Productivo Local — plantilla de variables de entorno
# Uso:  cp .env.example .env   (nunca commitear el .env real)
# Spec: docs/infrastructure/docker-setup.md §4
# ─────────────────────────────────────────────────────────────────────

# Perfiles Compose habilitados por defecto (permite `docker compose up -d` = stack completo).
# `dbt` se mantiene fuera: se ejecuta on-demand con `--profile transform`.
COMPOSE_PROFILES=core,orchestration,ml,bi

# ── 1. PostgreSQL (OLTP + metadata stores) ───────────────────────────
POSTGRES_USER=datalab
POSTGRES_PASSWORD=datalab_dev_pwd
POSTGRES_OLTP_DB=ecommerce_oltp
POSTGRES_META_DB=datalab_meta
POSTGRES_AIRFLOW_DB=airflow_meta
POSTGRES_PORT=5432

# ── 2. MinIO (Data Lake compatible con S3) ───────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=datalake
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 3. ClickHouse (Data Warehouse OLAP) ──────────────────────────────
CLICKHOUSE_USER=dbt
CLICKHOUSE_PASSWORD=dbt_dev_pwd
CLICKHOUSE_DB=marts
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9100
# Windows: si el bind falla con "forbidden by its access permissions" (rango
# excluido de WinNAT, ver runbook §4), remapear aquí, p. ej. 18123.

# ── 4. Apache Airflow ────────────────────────────────────────────────
# 50000 = usuario `airflow` de la imagen (tiene entrada en /etc/passwd y es dueño
# del volumen de logs; UIDs arbitrarios rompen `airflow users create`).
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=Zq4t7w9zSj1kP3mR6uV8xY2bC5dE7fG9hJ1kL3mN5pQ=
AIRFLOW_WEBSERVER_PORT=8080

# ── 5. dbt ───────────────────────────────────────────────────────────
DBT_PROFILES_DIR=/usr/app/dbt
DBT_TARGET=dev
DBT_THREADS=4

# ── 6. MLflow + artefactos S3 ────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_EXPERIMENT_NAME=churn_prediction
MLFLOW_PORT=5000

# ── 7. JupyterLab ────────────────────────────────────────────────────
JUPYTER_TOKEN=datalab
JUPYTER_PORT=8888

# ── 8. Metabase / Superset ───────────────────────────────────────────
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@datalab.local
METABASE_ADMIN_PASSWORD=metabase_dev_pwd
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change_me_superset_secret_key
SUPERSET_ADMIN_PASSWORD=admin
# Windows: si el bind de 8088 falla (WinNAT, ver runbook §4), usar p. ej. 18088.

# ── 9. Memoria de largo plazo (Qdrant) ───────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=datalab_knowledge

# ── 10. Convenciones de la sesión de agentes ─────────────────────────
DATALAB_ENV=local
DATALAB_TIMEZONE=UTC
RUN_BUDGET_SECONDS=1800
DRIFT_PSI_THRESHOLD=0.2
